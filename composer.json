{
    "name": "intent/intent-seo",
    "description": "AI-powered SEO optimization package for Intent Framework. Forked from rumenx/php-seo and modified exclusively for Intent Framework integration.",
    "keywords": [
        "seo",
        "meta-tags",
        "intent-framework",
        "ai-powered",
        "automation",
        "optimization",
        "php",
        "openai",
        "claude",
        "ollama"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aamir Ali",
            "email": "aamirabdullah33@gmail.com",
            "homepage": "https://github.com/aamirali51",
            "role": "Developer"
        },
        {
            "name": "Rumen Damyanov",
            "email": "contact@rumenx.com",
            "homepage": "https://github.com/RumenDamyanov",
            "role": "Original Author"
        }
    ],
    "homepage": "https://github.com/aamirali51/intent-seo",
    "support": {
        "issues": "https://github.com/aamirali51/intent-seo/issues",
        "source": "https://github.com/aamirali51/intent-seo"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.48",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-type-coverage": "^2.8",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-strict-rules": "^1.5",
        "squizlabs/php_codesniffer": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Intent\\Seo\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Intent\\Seo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "test-coverage-html": "pest --coverage-html coverage",
        "analyze": "phpstan analyse",
        "style": "phpcs",
        "style-fix": "php-cs-fixer fix",
        "quality": [
            "@style",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}